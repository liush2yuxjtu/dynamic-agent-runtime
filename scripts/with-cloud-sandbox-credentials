#!/bin/sh
set -eu

load_secret() {
  variable="$1"
  file="$2"
  current="$(printenv "$variable" 2>/dev/null || true)"
  if [ -n "$current" ] || [ ! -f "$file" ]; then
    return
  fi

  mode="$(stat -f '%Lp' "$file")"
  if [ "$mode" != 600 ] && [ "$mode" != 400 ]; then
    printf 'Refusing credential file with mode %s: %s\n' "$mode" "$file" >&2
    exit 65
  fi

  value="$(cat "$file")"
  if [ -z "$value" ]; then
    printf 'Empty credential file: %s\n' "$file" >&2
    exit 65
  fi
  export "$variable=$value"
}

load_secret VERCEL_TOKEN "$HOME/.config/dynamic-agent-runtime/vercel-token"
load_secret E2B_API_KEY "$HOME/.config/dynamic-agent-runtime/e2b-api-key"
exec "$@"
